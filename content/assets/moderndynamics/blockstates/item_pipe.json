{
  "multipart": [
    { "apply": { "model": "moderndynamics:block/item_pipe_core" } },
    { "when": { "down": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm" } },
    { "when": { "up": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm", "x": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm", "x": 270 } },
    { "when": { "east": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm", "z": 90 } },
    { "when": { "west": "true" }, "apply": { "model": "moderndynamics:block/item_pipe_arm", "z": 270 } }
  ]
}
